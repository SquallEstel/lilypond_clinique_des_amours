\ActeScene "S" "Scène" "9" ""

\Dialogue ""
"Don Juan fait le siège de la chambre de Mimi."
""

\Dialogue \DE ""
\markup {
  \wordwrap {
    Don Juan, je vous ai déjà dit non.
  }
}

\Dialogue \DDJ ""
\markup {
  \wordwrap {
    Et moi, je vous ai déjà dit si.
  }
}

\Dialogue \DE ""
\markup {
  \wordwrap {
    Laissez notre Mimi tranquille.
  }
}

\Dialogue \DDJ ""
\markup {
  \wordwrap {
    C’est contre ma nature. Tant qu’une forteresse ne s’est pas rendue, je l’assiège.
  }
}

\Dialogue \DE ""
\markup {
  \wordwrap {
    Mais elle ne vous a rien demandé, la forteresse.
  }
}

\Dialogue \DDJ ""
\markup {
  \wordwrap {
    Et par votre faute, je n’ai rien pu lui demander encore. Une fois, deux fois, trois fois, implacable sorcière, me laisserez-vous frapper à sa porte ?
  }
}

\Dialogue \DE ""
\markup {
  \wordwrap {
    Non. Chantez à sa fenêtre, si vous voulez, mais quant à sa porte, je m’institue son cerbère.
  }
}

\Dialogue \DDJ ""
\markup {
  \wordwrap {
    Oh, une aubade ! Voilà qui est dans mon rayon.
  }
}